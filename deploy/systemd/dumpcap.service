[Unit]
Description=dumpcap 网络采集器(可选, 有线网卡 → webshark spool)
After=network.target

[Service]
User=webshark
Group=webshark
EnvironmentFile=-/opt/webshark/webshark.env
# 网络抓包需 NET_ADMIN+NET_RAW(Ambient 授予, 兜底 apt 包自带的 filecap)
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ExecStart=/usr/bin/dumpcap -i ${NETWORK_IFACE} -b filesize:8388608 -b files:16 -w /opt/webshark/spool/net.pcapng
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
