# dumpcap：环形抓包写 webshark spool 分片目录
# 与 sharkd/webshark 同一用户运行：同一用户写/读 spool，避免 0600 分片
# 属主隔离导致 sharkd/webshark 读不到。抓包权限来自发行版赋予二进制的
# filecap（cap_net_admin,cap_net_raw），与运行用户无关，无权限提升。
# 若必须分离用户：0600 捕获文件默认不可被其他用户读取，需额外 ACL 或
# 轮转后 chmod，本仓不提供，见 docs/deployment.md。
# -b files:16 必须与 webshark -ring 16 对齐。
[Unit]
Description=dumpcap ring capture into webshark spool
After=network.target
Before=webshark.service

[Service]
User=webshark
ExecStart=/usr/bin/dumpcap -i eth0 -b filesize:8388608 -b files:16 -w /var/lib/webshark/net.pcapng
Restart=always
RestartSec=3

# 仅需抓包与写 spool，收紧其余权限（dumpcap 需要原始能力，NoNewPrivileges 不设 yes）
ProtectSystem=strict
ReadWritePaths=/var/lib/webshark
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
